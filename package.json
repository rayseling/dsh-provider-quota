{
  "name": "dsh-codex-lite",
  "version": "0.4.0",
  "description": "ChatGPT-subscription Codex route for DeepSeek Harness: official pi-ai OAuth/adapter, owner-only credentials, terminal login, selectable model listings, provider-aware quota display (Codex 5h/7d, OpenCode Go 5h/7d/1m, DeepSeek balance), and per-model context settings. No tools or default changes.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./usage": "./src/usage.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-codex-lite": "src/bin.js"
  },
  "scripts": {
    "test": "node scripts/check.mjs",
    "test:raw": "node --test"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-atomic-write": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-launch-environment": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-llm-pi-ai": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/schemastery": "*",
    "@earendil-works/pi-ai": "^0.84.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-settings-file": "*"
  }
}
