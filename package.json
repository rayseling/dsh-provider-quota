{
  "name": "dsh-codex-lite",
  "version": "0.1.0",
  "description": "Minimal ChatGPT-subscription model route for DeepSeek Harness: official pi-ai Codex OAuth + the official PiAiAdapter, one file credential store, and a terminal login. No HTTP routes, no tools, no browser code, no default changes.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-codex-lite": "src/bin.js"
  },
  "scripts": {
    "test": "node --test"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-atomic-write": "*",
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-llm-pi-ai": "*",
    "@deepseek-ai/schemastery": "*",
    "@earendil-works/pi-ai": "^0.82.1"
  }
}
