{
  "name": "dsh-provider-quota",
  "version": "0.7.1",
  "description": "Account-quota surface for a DeepSeek Harness composition: one authenticated Connection RPC plus a session-header chip showing the usage of whichever route the session is on — Codex 5h/7d, OpenCode Go 5h/7d/1m, or the DeepSeek balance. Registers no model route and no settings section.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./usage": "./src/usage.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node scripts/check.mjs",
    "test:raw": "node --test"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-launch-environment": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.2-alpha.1",
    "@earendil-works/pi-ai": "^1.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-app-boot": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-base": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-config-editor": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-credentials-local": "*",
    "@deepseek-ai/dsh-settings": ">=0.1.7-alpha.1",
    "@deepseek-ai/schemastery": "*"
  }
}
